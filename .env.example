# Copy to .env and fill in real values. Never commit the real .env file.

# Required for sessions to survive a process restart (see SECURITY.md).
# Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
AERIONX_JWT_SECRET=

# Optional — set this to require a shared passphrase before ANYTHING is
# reachable (good for sharing a public link with non-technical people).
# Leave blank/unset to disable (default).
AERIONX_SITE_PASSPHRASE=

# Optional — comma-separated list of allowed origins for CORS. Set to your
# real public URL(s) once deployed (defaults to localhost only).
AERIONX_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional — safe defaults shown (see core/config.py)
AERIONX_DETECTOR_CONFIDENCE=0.35
AERIONX_TRACKER_IOU=0.3
AERIONX_TRACKER_MAX_MISSED=15
AERIONX_TRACKER_MAX_CENTROID_DIST=80.0
AERIONX_STATIONARY_ALERT_SECONDS=5.0
AERIONX_LOG_LEVEL=INFO
AERIONX_DATA_DIR=data
